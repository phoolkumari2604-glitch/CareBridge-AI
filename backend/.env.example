# =========================================================
# CAREBRIDGE AI — BACKEND ENVIRONMENT CONFIGURATION
# =========================================================

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=CareBridge

# MongoDB Database Name
DATABASE_NAME=carebridge_ai

# JWT Secret Key for token signing & verification
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here

# Server Port
PORT=5000

# Environment Mode (development / production)
FLASK_ENV=development

# =========================================================
# EXTERNAL DATA PROVIDER INTEGRATIONS (OPTIONAL)
# =========================================================

# Source 1: API Ninjas Hospitals API (https://api-ninjas.com/api/hospitals)
# Leave blank or set your API Ninjas key
API_NINJAS_KEY=your_api_ninjas_key_here

# Source 2: U.S. CMS Provider Data API (Public Open Data)
CMS_DATASET_URL=https://data.cms.gov/provider-data/api/1/datastore/query/xubh-q36u/0

# Source 3: India HMIS (Ministry of Health & Family Welfare - https://www.hmis.mohfw.gov.in/)
# HMIS Gateway credentials (when authorized by MoHFW)
HMIS_CLIENT_ID=your_hmis_client_id_here
HMIS_CLIENT_SECRET=your_hmis_client_secret_here
